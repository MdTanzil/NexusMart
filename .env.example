# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus_ecommerce?schema=public"

# Auth.js / NextAuth Configuration
AUTH_SECRET="super-secret-enterprise-key-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment Gateways (Integration-Ready)
SSLCOMMERZ_STORE_ID="nexus_test_store"
SSLCOMMERZ_STORE_PASSWORD="nexus_test_password"
SSLCOMMERZ_IS_LIVE="false"

BKASH_APP_KEY="bkash_sandbox_key"
BKASH_APP_SECRET="bkash_sandbox_secret"
BKASH_USERNAME="bkash_sandbox_user"
BKASH_PASSWORD="bkash_sandbox_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

NAGAD_MERCHANT_ID="nagad_sandbox_merchant"
NAGAD_PUBLIC_KEY="nagad_public_key"
NAGAD_PRIVATE_KEY="nagad_private_key"

STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"

# Courier Integrations (Steadfast, Pathao, RedX)
STEADFAST_API_KEY="steadfast_api_key"
STEADFAST_SECRET_KEY="steadfast_secret_key"
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"

PATHAO_CLIENT_ID="pathao_client_id"
PATHAO_CLIENT_SECRET="pathao_client_secret"
